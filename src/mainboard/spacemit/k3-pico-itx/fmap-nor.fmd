# Physical 8 MiB NOR. Preserve all existing partition start addresses.
FLASH 0x800000 {
	BOOTINFO(PRESERVE)@0x0 0x20000
	BOOTBLOCK@0x20000 0x80000
	ENVIRONMENT(PRESERVE)@0xa0000 0x10000
	BOOT_RESERVED(PRESERVE)@0xb0000 0x100000
	FMAP@0x1b0000 0x1000
	EARLY_RESERVED(PRESERVE)@0x1b1000 0x5f000
	COREBOOT(CBFS)@0x210000 0x300000
	RESERVED(PRESERVE)@0x510000 0x1f0000
	UEFI_VARIABLES(PRESERVE)@0x700000 0xc0000
	TAIL(PRESERVE)@0x7c0000 0x40000
}
