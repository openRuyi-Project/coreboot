if BOARD_SIFIVE_HIFIVE_UNMATCHED

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select SOC_SIFIVE_FU740
	select BOARD_ROMSIZE_KB_8192
	select MISSING_BOARD_RESET
	select FLATTENED_DEVICE_TREE
	select SPI_FLASH
	select SPI_FLASH_ISSI
	select SPI_SDCARD

config HIFIVE_UNMATCHED_JTAG_BOOT
	bool "Load CBFS into DRAM over JTAG"
	default n
	help
	  Read the firmware image from DRAM at 0x90000000. Load bootblock
	  at 0x08000000 and start all five harts after reset. Break at
	  cbmem_initialize_empty(), after DDR initialization, to load CBFS
	  before resuming. This leaves SPI flash and the SD card untouched.

config HEAP_SIZE
	default 0x20000

config MAINBOARD_DIR
	default "sifive/hifive-unmatched"

config FMDFILE
	default "src/mainboard/sifive/hifive-unmatched/board.fmd"

config MAINBOARD_PART_NUMBER
	default "HiFive Unmatched"

endif
